# Copy to .env and edit. Do not commit .env.

# Database (required)
SUPPORTHUB_DATABASE_URL=postgresql+psycopg://postgres:medeveloper@127.0.0.1:5432/supporthub
SUPPORTHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-run

# Auth / session
SUPPORTHUB_ENV=local
SUPPORTHUB_SECRET=
SUPPORTHUB_SESSION_AGE=604800
SUPPORTHUB_SECURE_COOKIES=false

# Server
SUPPORTHUB_HOST=127.0.0.1
SUPPORTHUB_PORT=8888

# Paths (optional; empty = default monitoring_line_map.json under project)
SUPPORTHUB_LINE_MACHINE_MAP_FILE=

# LINE Notify (optional)
LINE_NOTIFY_TOKEN=

# MQTT / IoT
SUPPORTHUB_MQTT_HOST=192.168.1.109
SUPPORTHUB_MQTT_PORT=1883
SUPPORTHUB_MQTT_TOPIC=power/pzem
SUPPORTHUB_MQTT_CLIENT_ID=SUPPORTHUB-IOT-MONITOR
SUPPORTHUB_IOT_SAMPLE_LIMIT=180
